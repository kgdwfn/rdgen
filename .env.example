# 复制为同目录下的 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被提交/覆盖）
#   cp .env.example .env
#
# 这些值会覆盖 docker-compose.yml 里的占位符（compose 自动读取同目录 .env 做插值）。
# 真实值只放在 .env 里，不要写进 docker-compose.yml —— 否则 git pull 会把凭据覆盖掉。

# GitHub 账号（仓库所有者）
GHUSER=your_github_username

# GitHub 访问令牌（需具备 actions:write 权限）
GHBEARER=your_github_token

# 本服务的对外访问地址（用于客户端更新链接与产物回传）
GENURL=https://your-server-domain

# 自建（自托管）模式的密钥，留空表示非自建
SH_SECRET=

# 加密 zip 的密码，留空即可
ZIP_PASSWORD=
